# -----------------------------------------------------------------------------
# Copy to .env and adjust:   cp .env.example .env
# Every value below is FAKE. Never commit a real .env.
# The defaults work with the bundled mock IdP (npm run mock-idp).
# -----------------------------------------------------------------------------

# Public origin of this app (scheme + host + port, no path). Use "localhost",
# not 127.0.0.1: cookies are bound to the host name you browse with.
BETTER_AUTH_URL=http://localhost:3000

# Secret used to sign cookies and encrypt OAuth state. At least 32 characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# SQLite database file (created on first `npm run db:migrate`).
DATABASE_PATH=./dev.db

# --- Microsoft Entra ID app registration --------------------------------------
# Application (client) ID of the app registration.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000001
# Client secret *value* (not the secret ID) from "Certificates & secrets".
ENTRA_CLIENT_SECRET=mock-client-secret
# "OpenID Connect metadata document" from the app registration's Endpoints page.
# Must be tenant-specific (contains your tenant ID, not "common").
ENTRA_DISCOVERY_URL=http://127.0.0.1:4011/11111111-2222-3333-4444-555555555555/v2.0/.well-known/openid-configuration

# --- Optional ----------------------------------------------------------------
# Redirect URI sent to Entra and accepted by this app. Must have the same origin
# as BETTER_AUTH_URL and be registered in Entra (platform "Web") exactly as written.
# Unset = http://localhost:3000/api/auth/callback/entra (derived from BETTER_AUTH_URL).
# Any other path works without code changes, for example:
# ENTRA_REDIRECT_URI=http://localhost:3000/signin-oidc
# ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback/azure-ad

# Override endpoints from the discovery document (rarely needed).
# ENTRA_AUTHORIZATION_URL=
# ENTRA_TOKEN_URL=

# Space- or comma-separated scopes. Default: openid profile email offline_access
# ENTRA_SCOPES=openid profile email offline_access

# Set to "off" to disable Better Auth's rate limiter (used by the e2e tests only).
# AUTH_RATE_LIMIT=off

# -----------------------------------------------------------------------------
# Example for a REAL Entra ID tenant (placeholders in <angle brackets>):
#
# BETTER_AUTH_URL=http://localhost:3000
# ENTRA_CLIENT_ID=<application-client-id-guid>
# ENTRA_CLIENT_SECRET=<client-secret-value>
# ENTRA_DISCOVERY_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# ENTRA_REDIRECT_URI=http://localhost:3000/signin-oidc
#
# The discovery document then provides, among others:
#   authorization_endpoint  https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
#   token_endpoint          https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
#   issuer                  https://login.microsoftonline.com/<tenant-id>/v2.0
# -----------------------------------------------------------------------------
